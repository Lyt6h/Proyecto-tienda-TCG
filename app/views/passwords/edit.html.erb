<div class="poke-page">
  <div class="pokeball-container">
    <div class="cap top-cap"><div class="cutout"></div></div>

    <div class="screen-content">
      <div class="logo-box">
        <h2 class="welcome-msg"><%= t("passwords.edit.title") %></h2>
      </div>

      <%= form_with url: password_path(token: params[:token]), method: :patch, class: "condensed-form" do |f| %>
        <% if @user&.errors&.any? %>
          <div class="error-messages">
            <ul>
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="poke-field">
          <span class="icon">🔒</span>
          <%= f.password_field :password, placeholder: t("passwords.edit.password_placeholder"), class: "p-input", required: true %>
        </div>

        <div class="poke-field">
          <span class="icon">🔑</span>
          <%= f.password_field :password_confirmation, placeholder: t("passwords.edit.password_confirmation_placeholder"), class: "p-input", required: true %>
        </div>

        <div class="btn-container">
          <%= f.submit t("passwords.edit.submit"), class: "p-submit" %>
          <div class="btn-dot"></div>
        </div>
      <% end %>

      <div class="poke-footer">
        <%= link_to t("passwords.edit.cancel"), new_session_path, class: "p-link bold" %>
      </div>
    </div>

    <div class="cap bottom-cap"><div class="cutout"></div></div>
  </div>
</div>
