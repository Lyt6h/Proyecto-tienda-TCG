<style>
  .card-image-link:hover {
    transform: scale(1.1);
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    cursor: pointer;
  }
  .card-title-link:hover {
    color: #30a7d7 !important;
    text-decoration: underline;
  }
  /* Status Badge Styles */
  .status-tag {
    font-family: 'Press Start 2P', cursive;
    font-size: 8px;
    padding: 6px 12px;
    border-radius: 4px;
    border: 3px solid black;
    color: white;
    text-transform: uppercase;
    box-shadow: 3px 3px 0px rgba(0,0,0,0.2);
  }
  .status-pending_approval { background-color: #30a7d7; }
  .status-accepted { background-color: #4CAF50; }
  .status-rejected { background-color: #E3350D; }
  
  .filter-select {
    font-family: 'Press Start 2P', cursive;
    font-size: 8px;
    padding: 8px;
    border: 2px solid black;
    border-radius: 5px;
    background: white;
    outline: none;
  }
</style>

<div class="pokedex-background">
  <div class="pokedex-frame">
    <h1 style="font-family: 'Press Start 2P', cursive; font-size: 16px; text-align: center; margin-top: 50px; margin-bottom: 20px;"><%= t("purchases.title", default: "Mi Historial de Compras 📦") %></h1>

    <%# Filtros de Estado %>
    <div style="margin-bottom: 30px; text-align: center;">
      <%= form_with url: purchases_path, method: :get, local: true, class: "filter-form" do |f| %>
        <span style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin-right: 10px;"><%= t("sales.filter_status") %>:</span>
        <%= f.select :status, 
            [[t("sales.all_statuses"), ""], 
             [t("sales.pending_approval"), "pending_approval"], 
             [t("sales.accepted"), "accepted"], 
             [t("sales.rejected"), "rejected"]], 
            { selected: params[:status] }, 
            { class: "filter-select", onchange: "this.form.submit()" } %>
      <% end %>
    </div>

    <div style="display: flex; flex-direction: column; gap: 20px;">
      <% if @orders.any? %>
        <% @orders.each do |order| %>
          <div style="border: 4px solid #000; padding: 15px; border-radius: 10px; background: white; box-shadow: 4px 4px 0px black;">
            
            <!-- Cabecera del Pedido -->
            <div style="border-bottom: 2px dashed #ccc; padding-bottom: 10px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap;">
              <span style="font-family: 'Press Start 2P', cursive; font-size: 10px;"><%= t("purchases.order") %> #<%= order.id %></span>
              
              <div style="display: flex; align-items: center; gap: 15px;">
                <span class="status-tag status-<%= order.status %>">
                  <%= t("sales.#{order.status}", default: order.status.upcase) %>
                </span>
                <span style="font-family: 'Press Start 2P', cursive; font-size: 8px; color: #777;"><%= order.created_at.strftime("%d/%m/%Y") %></span>
              </div>
            </div>

            <!-- Lista de Cartas en este Pedido -->
            <% order.order_items.each do |item| %>
              <% subtotal_item = item.quantity * item.unit_price %>

              <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                <% if item.listing.card.image_url.present? %>
                  <%= link_to product_path(item.listing) do %>
                    <img src="<%= item.listing.card.image_url %>" alt="<%= item.listing.card.name %>" class="card-image-link" style="width: 60px; border: 2px solid black; border-radius: 5px; transition: transform 0.2s, box-shadow 0.2s;">
                  <% end %>
                <% end %>
                
                <div style="flex-grow: 1;">
                  <%= link_to product_path(item.listing), style: "text-decoration: none; color: black;" do %>
                    <h3 class="card-title-link" style="font-family: 'Press Start 2P', cursive; font-size: 10px; margin: 0 0 8px 0;"><%= item.listing.card.name %></h3>
                  <% end %>
                  <p style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin: 0; color: #555;"><%= t("purchases.quantity") %>: <%= item.quantity %> x $<%= item.unit_price %></p>
                </div>
                
                <div>
                  <strong style="font-family: 'Press Start 2P', cursive; font-size: 10px; color: #30a7d7;">$<%= subtotal_item %></strong>
                </div>
                
                <% if order.status == 'accepted' %>
                  <div style="margin-left: 15px;">
                    <% if item.review.present? %>
                      <span style="font-family: 'Press Start 2P', cursive; font-size: 8px; color: #FFCC00; background: #333; padding: 4px 8px; border-radius: 4px; border: 1px solid black;">
                        Carta: <%= "★" * item.review.item_rating %><%= "☆" * (5 - item.review.item_rating) %>
                      </span>
                    <% else %>
                      <%= link_to t("purchases.leave_review"), new_order_item_review_path(order_item_id: item.id), class: "btn-interactive", style: "background: #FFCC00; color: black; border: 2px solid black; padding: 5px 10px; cursor: pointer; font-family: 'Press Start 2P', cursive; font-size: 7px; border-radius: 3px; text-decoration: none; display: inline-block;" %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
            
            <!-- Total del Pedido -->
            <div style="text-align: right; margin-top: 10px; padding-top: 15px; border-top: 2px dashed #ccc; font-family: 'Press Start 2P', cursive;">
              <p style="font-size: 7px; color: #666; margin: 0 0 5px 0;"><%= t("sales.subtotal", default: "Subtotal") %>: $<%= order.subtotal %></p>
              <p style="font-size: 7px; color: #666; margin: 0 0 10px 0;"><%= t("sales.service_fee", default: "Cargo Servicio") %>: $<%= order.service_fee %></p>
              <strong style="font-size: 12px; color: #E3350D;"><%= t("purchases.total") %>: $<%= order.total_price %></strong>
            </div>
            
          </div>
        <% end %>
      <% else %>
        <!-- Mensaje si no hay compras -->
        <div style="text-align: center; padding: 40px; border: 4px solid #000; border-radius: 10px; background: white; box-shadow: 4px 4px 0px black;">
          <p style="font-family: 'Press Start 2P', cursive; font-size: 10px; line-height: 1.5; margin-bottom: 20px;"><%= t("purchases.empty", default: "Aún no has comprado ninguna carta. ¡Anímate a atrapar la primera!") %></p>
          <%= link_to t("purchases.go_shop", default: "¡Ir de compras!"), products_path, style: "color: #30a7d7; font-family: 'Press Start 2P', cursive; font-size: 10px; text-decoration: none; border-bottom: 2px solid #30a7d7; padding-bottom: 2px;" %>
        </div>
      <% end %>
    </div>
    
    <!-- Botón Volver -->
    <div style="text-align: center; margin-top: 30px;">
      <%= link_to t("purchases.back", default: "Volver a la Tienda"), products_path, class: "btn-interactive", style: "background: #333; color: white; padding: 12px; border: 2px solid black; text-decoration: none; font-family: 'Press Start 2P', cursive; font-size: 10px; border-radius: 5px; display: inline-block;" %>
    </div>
  </div>
</div>