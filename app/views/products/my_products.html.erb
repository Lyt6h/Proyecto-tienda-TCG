<div class="pueblo-paleta-bg" style="background-image: url('<%= asset_path('puebloPaleta.webp') %>'); background-size: cover; background-position: center; background-attachment: fixed; min-height: 100vh; padding-top: 100px;">
  <div class="kanto-container">
    <div class="kanto-box" style="max-width: 900px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 4px dashed #222224; padding-bottom: 15px;">
        <h1 class="kanto-title" style="margin-bottom: 0; border-bottom: none;"><%= t('layout.my_cards') %></h1>
        <%= link_to t("products.actions.api_search_btn"), api_cards_search_path, class: "kanto-btn kanto-btn-submit btn-interactive" %>
      </div>

      <% if @products.any? %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px;">
          <% @products.each do |listing| %>
            <div class="kanto-card" style="background: white; border: 4px solid black; padding: 10px; border-radius: 10px; box-shadow: 4px 4px 0px black; display: flex; flex-direction: column; text-align: center; position: relative;">
              
              <% if listing.stock <= 0 %>
                <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.7); z-index: 5; display: flex; align-items: center; justify-content: center; pointer-events: none;">
                  <div style="position: absolute; width: 140%; height: 4px; background: #E3350D; transform: rotate(45deg);"></div>
                  <div style="background: #E3350D; color: white; padding: 5px 10px; font-size: 8px; border: 2px solid black; transform: rotate(-10deg); font-family: 'Press Start 2P', cursive; z-index: 6;"><%= t("products.out_of_stock_label") %></div>
                </div>
              <% end %>

              <div style="margin-bottom: 8px;">
                <% if listing.card.image_url.present? %>
                  <img src="<%= listing.card.image_url %>" alt="<%= listing.card.name %>" style="width: 100%; max-width: 90px; margin-bottom: 8px; image-rendering: pixelated; border: 2px solid black;">
                <% end %>
                <h3 style="font-size: 9px; margin-bottom: 3px; color: #222; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= listing.card.name.upcase %></h3>
                <p style="font-size: 6px; color: #666; margin: 2px 0;"><%= listing.card.expansion %></p>
              </div>

              <div style="text-align: left; background: #f9f9f9; padding: 6px; border: 2px solid #eee; border-radius: 5px; margin-bottom: 8px; font-family: 'Press Start 2P', cursive; line-height: 1.4;">
                <p style="font-size: 5.5px; margin: 2px 0;"><%= t("products.year_label") %>: <%= listing.card.release_year %></p>
                <p style="font-size: 5.5px; margin: 2px 0;"><%= t("products.rarity_label") %>: <%= listing.card.rarity %></p>
                <p style="font-size: 5.5px; margin: 2px 0;"><%= t("products.filter_energy") %>: <%= listing.card.energy_type %></p>
                <p style="font-size: 5.5px; margin: 2px 0;"><%= t("products.filter_condition") %>: <%= listing.condition %></p>
                <p style="font-size: 5.5px; margin: 3px 0 0 0; color: #30a7d7;"><strong>STOCK: <%= listing.stock %></strong></p>
              </div>

              <div style="font-size: 10px; color: #E3350D; margin-bottom: 8px; font-family: 'Press Start 2P', cursive;"><strong>$<%= listing.price %></strong></div>

              <div style="display: flex; gap: 5px; margin-top: auto;">
                <%= link_to t('products.actions.edit'), edit_product_path(listing), class: "kanto-btn btn-interactive", style: "background: #30a7d7; color: white; flex: 1; padding: 6px; font-size: 5px;" %>
                <%= button_to t('products.actions.delete'), product_path(listing), method: :delete, data: { confirm: t('products.actions.confirm_delete') }, class: "kanto-btn btn-interactive", style: "background: #E3350D; color: white; flex: 1; padding: 6px; font-size: 5px;" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div style="text-align: center; padding: 40px; color: #666; font-size: 10px;">
          <p><%= t('products.actions.no_cards') %></p>
        </div>
      <% end %>

      <%# Botón Volver (Estilo Wishlist) %>
      <div style="text-align: center; margin-top: 30px; border-top: 4px dashed #222224; padding-top: 20px;">
        <%= link_to t("favorites.back"), products_path, class: "kanto-btn btn-interactive", style: "background: #333; color: white; padding: 12px 25px; font-size: 10px;" %>
      </div>
    </div>
  </div>
</div>

<style>
  .kanto-container {
    display: flex;
    justify-content: center;
    padding: 20px;
  }

  .kanto-box {
    background-color: rgba(252, 252, 252, 0.95);
    border: 4px solid #222224;
    border-radius: 8px;
    box-shadow: 
      inset 0 0 0 2px #fff, 
      inset 0 0 0 4px #222224, 
      6px 6px 0px 0px rgba(0,0,0,0.5);
    padding: 30px;
    width: 100%;
    font-family: 'Press Start 2P', cursive;
  }

  .kanto-title {
    color: #E3350D;
    font-size: 16px;
    text-transform: uppercase;
  }

  .kanto-btn {
    font-family: 'Press Start 2P', cursive;
    font-size: 8px;
    padding: 10px 15px;
    border: 3px solid #222224;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    box-shadow: 2px 2px 0px #222224;
    transition: transform 0.1s, box-shadow 0.1s;
    display: inline-block;
  }

  .kanto-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px #222224;
  }

  .kanto-btn-submit {
    background-color: #30a7d7;
    color: white;
  }
</style>
