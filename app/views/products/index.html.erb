<div class="pokedex-background">
  <div class="pokedex-frame">
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
      <% @products.each do |listing| %>
        <div style="border: 4px solid #000; padding: 15px; border-radius: 10px; background: white; text-align: center; box-shadow: 4px 4px 0px #333;">
          <%= link_to product_path(listing), style: "text-decoration: none; color: inherit;" do %>
            <% if listing.card.image_url.present? %>
              <div data-controller="card-tilt"
                  data-card-tilt-rarity-value="<%= listing.card.rarity %>"
                  data-card-tilt-angle-value="20"
                  data-card-tilt-perspective-value="250"
                  data-card-tilt-scale-value="1.14"
                  data-card-tilt-return-value="1000"
                  style="display: inline-block; position: relative;">
                <img src="<%= listing.card.image_url %>"
                  alt="<%= listing.card.name %>"
                  style="width: 100%; max-width: 150px; margin-bottom: 10px; image-rendering: pixelated; border: 2px solid black; display: block; box-shadow: 5px 5px 0px rgba(0,0,0,0.5);">
                <div class="card-rainbow" style="position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 0.2s; background: linear-gradient(135deg, rgba(255,0,128,0.35), rgba(255,165,0,0.35), rgba(255,255,0,0.35), rgba(0,255,128,0.35), rgba(0,200,255,0.35), rgba(128,0,255,0.35)); background-size: 200% 200%; mix-blend-mode: screen;"></div>
                <div class="card-glitter" style="position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 0.2s; background-image: radial-gradient(circle, rgba(255,255,255,0.9) 1px, transparent 1px), radial-gradient(circle, rgba(255,200,255,0.7) 1px, transparent 1px); background-size: 40px 40px, 60px 60px;"></div>
                <div class="card-sheen"   style="position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 0.2s;"></div>
                <div class="card-shine"   style="position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 0.15s;"></div>
              </div>
            <% end %>

            <h3 style="font-family: 'Press Start 2P', cursive; font-size: 14px; margin-bottom: 5px;"><%= listing.card.name %></h3>
          <% end %>
          
          <p style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin: 2px 0;"><%= t("products.year_label") %> <%= listing.card.release_year %></p>
          <p style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin: 2px 0;"><%= t("products.filter_rarity") %> <%= listing.card.rarity %></p>
          <p style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin: 2px 0;"><%= t("products.filter_condition") %> <%= listing.condition %></p>
          <p style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin: 2px 0;"><%= t("products.seller") %> <%= listing.seller.username %></p>

          <p style="font-family: 'Press Start 2P', cursive; font-size: 12px; margin: 15px 0;"><strong>$<%= listing.price %></strong></p>
          
          <div style="display: flex; gap: 10px; margin-top: 10px;">
            <% if authenticated? %>
              <%# --- CORAZÓN PARA USUARIOS LOGUEADOS --- %>
              <% favorite = Current.user.favorites.find_by(card_id: listing.card.id) %>
              <% if favorite %>
                <%= button_to "❤️", favorite_path(id: favorite.id), method: :delete, style: "background: white; border: 2px solid black; padding: 10px; cursor: pointer; border-radius: 5px; font-size: 12px;", class: "btn-interactive" %>
              <% else %>
                <%= button_to "🤍", favorites_path(card_id: listing.card.id), method: :post, style: "background: white; border: 2px solid black; padding: 10px; cursor: pointer; border-radius: 5px; font-size: 12px;", class: "btn-interactive" %>
              <% end %>

              <%= button_to t("products.add_to_cart"), add_item_cart_path(listing_id: listing.id), method: :post,
                style: "background: #30a7d7; color: white; border: 2px solid black; padding: 10px; cursor: pointer; font-family: 'Press Start 2P', cursive; font-size: 8px; width: 100%; border-radius: 5px;", class: "btn-interactive" %>
            <% else %>
              <%# --- BOTONES PARA VISITANTES (ABREN MODAL) --- %>
              <button onclick="document.getElementById('login-required-popup').style.display='flex'" style="background: white; border: 2px solid black; padding: 10px; cursor: pointer; border-radius: 5px; font-size: 12px;" class="btn-interactive">
                🤍
              </button>

              <button onclick="document.getElementById('login-required-popup').style.display='flex'" style="background: #30a7d7; color: white; border: 2px solid black; padding: 10px; cursor: pointer; font-family: 'Press Start 2P', cursive; font-size: 8px; width: 100%; border-radius: 5px;" class="btn-interactive">
                <%= t("products.add_to_cart") %>
              </button>
            <% end %>
          </div>
          <p>
            <span style="font-size: 12px; font-family: 'Press Start 2P';"><%= listing.card.energy_type %></span>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# --- POP-UP DE LOGIN REQUERIDO PARA VISITANTES --- %>
<div id="login-required-popup" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.8); display: none; align-items: center; justify-content: center; z-index: 9999;">
  <div style="background: white; border: 6px solid black; padding: 40px 30px; text-align: center; max-width: 450px; font-family: 'Press Start 2P', cursive; box-shadow: 10px 10px 0px #30a7d7; position: relative;">
    
    <button onclick="document.getElementById('login-required-popup').style.display='none'" style="position: absolute; top: 10px; right: 15px; background: none; border: none; font-size: 16px; font-family: 'Press Start 2P', cursive; cursor: pointer; color: #E3350D;" class="btn-interactive">X</button>

    <h2 style="font-size: 14px; color: #30a7d7; margin-bottom: 25px; line-height: 1.4;">
      <%= t("products.notices.login_required_title", default: "¡NECESITAS UNA CUENTA!") %>
    </h2>
    
    <p style="font-size: 8px; line-height: 1.8; margin-bottom: 35px; color: #333;">
      <%= t("products.notices.login_required_body", default: "Para poder añadir productos al carro y realizar compras, debes iniciar sesión en la plataforma.") %>
    </p>
    
    <div style="display: flex; flex-direction: column; gap: 15px;">
      <%= link_to t("layout.sign_in", default: "INICIAR SESIÓN"), new_session_path, class: "btn-interactive", style: "background: #4CAF50; color: white; border: 3px solid black; padding: 15px; text-decoration: none; font-size: 9px; cursor: pointer;" %>
      <%= link_to t("layout.sign_up", default: "REGISTRARSE"), new_registration_path, class: "btn-interactive", style: "background: #FFCC00; color: black; border: 3px solid black; padding: 15px; text-decoration: none; font-size: 9px; cursor: pointer;" %>
    </div>
  </div>
</div>
