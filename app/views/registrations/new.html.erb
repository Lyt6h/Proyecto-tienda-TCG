<div class="poke-page">
  <div style="position: fixed; top: 20px; left: 30px; z-index: 1000;">
    <%= link_to products_path, class: "back-button-retro btn-interactive", style: "
      display: flex;
      align-items: center;
      justify-content: center;
      background: white;
      border: 3px solid black;
      width: 48px;
      height: 48px;
      border-radius: 5px;
      box-shadow: 4px 4px 0px black;
      text-decoration: none;
      transition: all 0.1s;
      cursor: pointer;
    " do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
        <path d="M15 18l-6-6 6-6" stroke="black" stroke-width="3" stroke-linecap="square"/>
      </svg>
    <% end %>
  </div>

  <div class="pokeball-container">
    <div class="cap top-cap">
      <div class="cutout"></div>
    </div>

    <div class="screen-content">
      <div class="logo-box">
        <img src="https://upload.wikimedia.org/wikipedia/commons/9/98/International_Pok%C3%A9mon_logo.svg" alt="Pokemon" class="main-logo">
        <h2 class="welcome-msg"><%= t("registrations.title") %></h2>
      </div>

      <%= form_with model: @user, url: registration_path, class: "condensed-form" do |f| %>
        <div class="poke-field-wrapper">
          <div class="poke-field <%= 'field-error' if @user.errors[:username].any? %>">
            <span class="icon">👤</span>
            <%= f.text_field :username, placeholder: t("registrations.username_placeholder"), class: "p-input", required: true, autocomplete: "off" %>
            <% if @user.errors[:username].any? %>
              <div class="error-trigger">
                ⚠️
                <span class="error-tooltip">
                  <% @user.errors[:username].each do |msg| %>
                    <div>• <%= msg %></div>
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
        </div>

        <div class="poke-field-wrapper">
          <div class="poke-field <%= 'field-error' if @user.errors[:email_address].any? %>">
            <span class="icon">🔴</span>
            <%= f.email_field :email_address, placeholder: t("registrations.email_placeholder"), class: "p-input", required: true, autocomplete: "off" %>
            <% if @user.errors[:email_address].any? %>
              <div class="error-trigger">
                ⚠️
                <span class="error-tooltip">
                  <% @user.errors[:email_address].each do |msg| %>
                    <div>• <%= msg %></div>
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
        </div>

        <div class="poke-field-wrapper">
          <div class="poke-field <%= 'field-error' if @user.errors[:password].any? %>">
            <span class="icon">🔒</span>
            <%= f.password_field :password, placeholder: t("registrations.password_placeholder"), class: "p-input", required: true, autocomplete: "new-password" %>
            <% if @user.errors[:password].any? %>
              <div class="error-trigger">
                ⚠️
                <span class="error-tooltip">
                  <% @user.errors[:password].each do |msg| %>
                    <div>• <%= msg %></div>
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
        </div>

        <div class="poke-field-wrapper">
          <div class="poke-field <%= 'field-error' if @user.errors[:password_confirmation].any? %>">
            <span class="icon">🔑</span>
            <%= f.password_field :password_confirmation, placeholder: t("registrations.password_confirmation_placeholder"), class: "p-input", required: true, autocomplete: "new-password" %>
            <% if @user.errors[:password_confirmation].any? %>
              <div class="error-trigger">
                ⚠️
                <span class="error-tooltip">
                  <% @user.errors[:password_confirmation].each do |msg| %>
                    <div>• <%= msg %></div>
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
        </div>

        <div class="btn-container">
          <%= f.submit t("registrations.submit"), class: "p-submit" %>
          <div class="btn-dot"></div>
        </div>
      <% end %>

      <div class="poke-footer">
        <div class="register-line">
          <%= t("registrations.already_have_account") %> <%= link_to t("registrations.sign_in"), new_session_path, class: "p-link bold" %>
        </div>
      </div>
    </div>

    <div class="cap bottom-cap">
      <div class="cutout"></div>
    </div>
  </div>

  <style>
    .poke-field-wrapper {
      margin-bottom: 12px;
      position: relative;
    }
    .poke-field {
      position: relative;
      display: flex;
      align-items: center;
    }
    .field-error {
      border: 3px solid #E3350D !important;
      background-color: #fff0f0 !important;
      border-radius: 5px;
    }
    .error-trigger {
      position: absolute;
      right: 10px;
      cursor: help;
      font-size: 14px;
      animation: pulse 1s infinite;
      display: flex;
      align-items: center;
    }
    .error-tooltip {
      visibility: hidden;
      width: 220px;
      background-color: #333;
      color: #fff;
      text-align: left;
      border-radius: 6px;
      padding: 10px;
      position: absolute;
      z-index: 10002;
      bottom: 125%;
      right: -10px;
      opacity: 0;
      transition: opacity 0.3s;
      font-family: 'Press Start 2P', cursive;
      font-size: 6px;
      line-height: 1.6;
      border: 2px solid white;
      box-shadow: 4px 4px 0px rgba(0,0,0,0.2);
    }
    .error-trigger:hover .error-tooltip {
      visibility: visible;
      opacity: 1;
    }
    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.2); }
      100% { transform: scale(1); }
    }
  </style>
</div>
