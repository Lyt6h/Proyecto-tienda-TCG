<div class="pokedex-background">
  <div class="pokedex-frame">
    <h1 style="font-family: 'Press Start 2P', cursive; font-size: 16px; text-align: center; margin-bottom: 20px;"><%= t("favorites.title") %></h1>

    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
      <% if @favorites.any? %>
        <% @favorites.each do |favorite| %>
          <div style="border: 4px solid #000; padding: 15px; border-radius: 10px; background: white; text-align: center; box-shadow: 4px 4px 0px black;">
            
            <% if favorite.card.image_url.present? %>
              <img src="<%= favorite.card.image_url %>" alt="<%= favorite.card.name %>" style="width: 100%; max-width: 120px; margin-bottom: 10px; border: 2px solid black;">
            <% end %>

            <h3 style="font-family: 'Press Start 2P', cursive; font-size: 12px; margin-bottom: 5px;"><%= favorite.card.name %></h3>
            
            <% best_listing = favorite.card.listings.where(status: 'active').where.not(seller_id: Current.user.id).order(:price).first %>

            <% if best_listing %>
              <p style="font-family: 'Press Start 2P'; font-size: 8px; margin: 10px 0;">
                <%= t("favorites.best_price") %> <strong style="color: #30a7d7;">$<%= best_listing.price %></strong>
              </p>
              
              <%= button_to t("favorites.add_to_cart"), add_item_cart_path(listing_id: best_listing.id), method: :post, 
                  style: "background: #30a7d7; color: white; border: 2px solid black; padding: 10px; cursor: pointer; font-family: 'Press Start 2P', cursive; font-size: 8px; width: 100%; border-radius: 5px;", class: "btn-interactive" %>
            <% else %>
              <p style="font-family: 'Press Start 2P'; font-size: 7px; color: #E3350D; margin: 15px 0; padding: 5px; border: 1px dashed #E3350D;">
                <%= t("favorites.out_of_stock") %>
              </p>
            <% end %>

            <%= button_to t("favorites.remove"), favorite_path(favorite.id), method: :delete, class: "btn-interactive", 
                style: "background: #E3350D; color: white; border: 2px solid black; padding: 8px; cursor: pointer; font-family: 'Press Start 2P', cursive; font-size: 8px; width: 100%; margin-top: 15px; border-radius: 5px;" %>
          </div>
        <% end %>
      <% else %>
        <div style="grid-column: span 3; text-align: center; padding: 40px;">
          <p style="font-family: 'Press Start 2P'; font-size: 10px;"><%= t("favorites.empty") %></p>
          <%= link_to t("favorites.go_search"), products_path, style: "color: #E3350D; font-family: 'Press Start 2P'; font-size: 8px;" %>
        </div>
      <% end %>
    </div>
    
    <div style="text-align: center; margin-top: 30px;">
      <%= link_to t("favorites.back"), products_path,class: "btn-interactive", style: "background: #333; color: white; padding: 10px; border: 2px solid black; text-decoration: none; font-family: 'Press Start 2P'; font-size: 10px; border-radius: 5px; display: inline-block;" %>
    </div>
  </div>
</div>