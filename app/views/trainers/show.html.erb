<% content_for :back_link, "javascript:history.back()" %>

<div style="
  min-height: 100vh;
  background-image: url('<%= image_path("puebloPaleta.webp") %>'); 
  background-size: cover;
  background-position: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 20px 20px;
  image-rendering: pixelated;
  font-family: 'Press Start 2P', cursive;
">

  <%# TRAINER CARD CONTAINER (PUBLIC) %>
  <div style="
    background: #fff;
    border: 6px solid #000;
    box-shadow: 10px 10px 0px rgba(0,0,0,0.5);
    width: 100%;
    max-width: 700px;
    padding: 30px;
    margin-bottom: 40px;
  ">
    
    <%# HEADER %>
    <div style="display: flex; justify-content: space-between; border-bottom: 4px solid #000; padding-bottom: 10px; margin-bottom: 25px;">
      <span style="font-size: 14px; color: #000;"><%= t("profiles.trainer_card") %></span>
      <span style="font-size: 10px; color: #E3350D;"><%= t("profiles.id_label") %> 00<%= @trainer.id %></span>
    </div>

    <div style="display: flex; gap: 40px; flex-wrap: wrap;">
      
      <%# LEFT SIDE: Photo %>
      <div style="flex: 0 0 200px; display: flex; flex-direction: column; align-items: center; gap: 20px;">
        <div style="
          width: 180px;
          height: 180px;
          background: #fff;
          border: 4px solid #000;
          border-radius: 50%;
          display: flex;
          justify-content: center;
          align-items: center;
          overflow: hidden;
          box-shadow: 4px 4px 0px rgba(0,0,0,0.2);
        ">
          <% if @trainer.profile_picture.attached? %>
            <%= image_tag @trainer.profile_picture, style: "width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated;" %>
          <% else %>
            <%= image_tag "default_trainer.png", style: "width: 100%; image-rendering: pixelated; margin-top: 10px;" %>
          <% end %>
        </div>
      </div>

      <%# RIGHT SIDE: Public Data %>
      <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 15px; justify-content: center;">
        
        <div>
          <span style="font-size: 8px; color: #666; display: block; margin-bottom: 5px;"><%= t("profiles.username").upcase %>:</span>
          <span style="font-size: 12px; border-bottom: 2px solid #000; padding: 2px 10px; display: inline-block; width: 100%; box-sizing: border-box;"><%= @trainer.username %></span>
        </div>

        <div>
          <span style="font-size: 8px; color: #666; display: block; margin-bottom: 5px;"><%= t("profiles.full_name", default: "Nombre Completo").upcase %>:</span>
          <span style="font-size: 10px; background: rgba(255,255,255,0.5); padding: 8px; border: 2px solid #000; border-radius: 4px; display: inline-block; width: 100%; box-sizing: border-box;">
            <%= @trainer.full_name.presence || "-" %>
          </span>
        </div>

        <div style="display: flex; gap: 15px;">
          <div style="flex: 1;">
            <span style="font-size: 8px; color: #666; display: block; margin-bottom: 5px;"><%= t("profiles.phone", default: "Teléfono").upcase %>:</span>
            <span style="font-size: 10px; background: rgba(255,255,255,0.5); padding: 8px; border: 2px solid #000; border-radius: 4px; display: inline-block; width: 100%; box-sizing: border-box;">
              <%= @trainer.phone_number.presence || "-" %>
            </span>
          </div>
          <div style="flex: 1;">
            <span style="font-size: 8px; color: #666; display: block; margin-bottom: 5px;"><%= t("profiles.street_placeholder", default: "Calle").upcase %>:</span>
            <span style="font-size: 10px; background: rgba(255,255,255,0.5); padding: 8px; border: 2px solid #000; border-radius: 4px; display: inline-block; width: 100%; box-sizing: border-box;">
              <%= @trainer.street.presence || "-" %>
            </span>
          </div>
        </div>

        <div style="display: flex; gap: 15px; align-items: flex-end;">
          <div style="flex: 1;">
            <span style="font-size: 8px; color: #666; display: block; margin-bottom: 5px;"><%= t("admin.users.show.stats.registered", default: "Inició su aventura").upcase %>:</span>
            <span style="font-size: 10px; background: rgba(255,255,255,0.5); padding: 8px; border: 2px solid #000; border-radius: 4px; display: inline-block; width: 100%; box-sizing: border-box;">
              <%= l @trainer.created_at.to_date, format: :long %>
            </span>
          </div>
          <div style="flex: 0 0 100px; text-align: center;">
            <span style="font-size: 8px; color: #666; display: block; margin-bottom: 5px;"><%= t("profiles.reputation", default: "Reputación").upcase %>:</span>
            <div style="font-size: 12px; color: #FFCC00; text-shadow: 1px 1px 0px #000;">
              <%= @average_rating %> ★
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# CATALOG / INVENTORY %>
  <div style="width: 100%; max-width: 900px;">
    <h2 style="font-size: 16px; color: white; text-shadow: 2px 2px 0px #000; text-align: center; margin-bottom: 30px;">
      <%= t("admin.users.show.catalog.title", default: "Catálogo") %>
    </h2>

    <% if @listings.any? %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
        <% @listings.each do |listing| %>
          <div style="border: 4px solid #000; padding: 15px; border-radius: 10px; background: white; text-align: center; box-shadow: 4px 4px 0px #333;">
            <%= link_to product_path(listing), style: "text-decoration: none; color: inherit;" do %>
              <% if listing.card.image_url.present? %>
                <div data-controller="card-tilt"
                    data-card-tilt-rarity-value="<%= listing.card.rarity %>"
                    data-card-tilt-angle-value="20"
                    data-card-tilt-perspective-value="250"
                    data-card-tilt-scale-value="1.14"
                    data-card-tilt-return-value="1000"
                    style="display: inline-block; position: relative;">
                  <img src="<%= listing.card.image_url %>"
                    alt="<%= listing.card.name %>"
                    style="width: 100%; max-width: 150px; margin-bottom: 10px; image-rendering: pixelated; border: 2px solid black; display: block; box-shadow: 5px 5px 0px rgba(0,0,0,0.5);">
                  <div class="card-rainbow" style="position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 0.2s; background: linear-gradient(135deg, rgba(255,0,128,0.35), rgba(255,165,0,0.35), rgba(255,255,0,0.35), rgba(0,255,128,0.35), rgba(0,200,255,0.35), rgba(128,0,255,0.35)); background-size: 200% 200%; mix-blend-mode: screen;"></div>
                  <div class="card-glitter" style="position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 0.2s; background-image: radial-gradient(circle, rgba(255,255,255,0.9) 1px, transparent 1px), radial-gradient(circle, rgba(255,200,255,0.7) 1px, transparent 1px); background-size: 40px 40px, 60px 60px;"></div>
                  <div class="card-sheen"   style="position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 0.2s;"></div>
                  <div class="card-shine"   style="position: absolute; inset: 0; border-radius: 4px; pointer-events: none; opacity: 0; transition: opacity 0.15s;"></div>
                </div>
              <% end %>

              <h3 style="font-family: 'Press Start 2P', cursive; font-size: 14px; margin-bottom: 5px;"><%= listing.card.name %></h3>
            <% end %>
            
            <p style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin: 2px 0;"><%= t("products.year_label") %> <%= listing.card.release_year %></p>
            <p style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin: 2px 0;"><%= t("products.filter_rarity") %> <%= listing.card.rarity %></p>
            <p style="font-family: 'Press Start 2P', cursive; font-size: 8px; margin: 2px 0;"><%= t("products.filter_condition") %> <%= listing.condition %></p>

            <p style="font-family: 'Press Start 2P', cursive; font-size: 12px; margin: 15px 0;"><strong>$<%= listing.price %></strong></p>
            
            <div style="display: flex; gap: 10px; margin-top: 10px;">
              <% if authenticated? %>
                <%# --- CORAZÓN PARA USUARIOS LOGUEADOS --- %>
                <% favorite = Current.user.favorites.find_by(card_id: listing.card.id) %>
                <% if favorite %>
                  <%= button_to "❤️", favorite_path(id: favorite.id), method: :delete, style: "background: white; border: 2px solid black; padding: 10px; cursor: pointer; border-radius: 5px; font-size: 12px;", class: "btn-interactive" %>
                <% else %>
                  <%= button_to "🤍", favorites_path(card_id: listing.card.id), method: :post, style: "background: white; border: 2px solid black; padding: 10px; cursor: pointer; border-radius: 5px; font-size: 12px;", class: "btn-interactive" %>
                <% end %>

                <%= button_to t("products.add_to_cart"), add_item_cart_path(listing_id: listing.id), method: :post,
                  style: "background: #30a7d7; color: white; border: 2px solid black; padding: 10px; cursor: pointer; font-family: 'Press Start 2P', cursive; font-size: 8px; width: 100%; border-radius: 5px;", class: "btn-interactive" %>
              <% else %>
                <%# --- BOTONES PARA VISITANTES (ABREN MODAL) --- %>
                <button onclick="document.getElementById('login-required-popup').style.display='flex'" style="background: white; border: 2px solid black; padding: 10px; cursor: pointer; border-radius: 5px; font-size: 12px;" class="btn-interactive">
                  🤍
                </button>

                <button onclick="document.getElementById('login-required-popup').style.display='flex'" style="background: #30a7d7; color: white; border: 2px solid black; padding: 10px; cursor: pointer; font-family: 'Press Start 2P', cursive; font-size: 8px; width: 100%; border-radius: 5px;" class="btn-interactive">
                  <%= t("products.add_to_cart") %>
                </button>
              <% end %>
            </div>
            <p>
              <span style="font-size: 12px; font-family: 'Press Start 2P';"><%= listing.card.energy_type %></span>
            </p>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="background: rgba(255,255,255,0.9); border: 4px solid #000; padding: 30px; text-align: center; border-radius: 10px;">
        <p style="font-size: 10px; color: #333;"><%= t("admin.users.show.catalog.no_listings", default: "No hay productos en venta en este momento.") %></p>
      </div>
    <% end %>
  </div>

  <%# SELLER REVIEWS SECTION %>
  <div style="width: 100%; max-width: 900px; margin-top: 50px;">
    <h2 style="font-size: 16px; color: white; text-shadow: 2px 2px 0px #000; text-align: center; margin-bottom: 30px;">
      <%= t("purchases.reviews_title", default: "Reseñas del Vendedor") %>
    </h2>

    <% if @seller_reviews.any? %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
        <% @seller_reviews.each do |rev| %>
          <% reviewer = rev.order_item.order.client %>
          <div style="background: #f8f8f8; border: 4px solid black; padding: 20px; box-shadow: 6px 6px 0px black; text-align: left; font-family: 'Press Start 2P', cursive;">
            
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
              <% if reviewer.profile_picture.attached? %>
                <%= image_tag url_for(reviewer.profile_picture), style: "width: 40px; height: 40px; border-radius: 50%; border: 3px solid black; object-fit: cover; flex-shrink: 0;" %>
              <% else %>
                <div style="width: 40px; height: 40px; border-radius: 50%; border: 3px solid black; background: #FFCC00; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0;">
                  <%= reviewer.username.first.upcase %>
                </div>
              <% end %>

              <div style="flex: 1; min-width: 0;">
                <span style="font-size: 8px; color: #333; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 4px;">
                  <%= reviewer.username %>
                  <span style="color: #4CAF50; font-size: 6px; margin-left: 5px;">[<%= t("reviews.verified_purchase", default: "COMPRA VERIFICADA") %> ✅]</span>
                </span>
                <span style="font-size: 6px; color: #666;"><%= rev.created_at.strftime("%d/%m/%Y") %></span>
              </div>

              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 5px; flex-shrink: 0;">
                <div style="background: #333; padding: 6px; border-radius: 4px;">
                  <span style="font-size: 8px; color: #FFCC00;">
                    <%= "★" * rev.seller_rating %><%= "☆" * (5 - rev.seller_rating) %>
                  </span>
                </div>
                <% if Current.user && Current.user != reviewer && !rev.reported? %>
                  <%= button_to report_review_path(rev), method: :patch, class: "btn-interactive", style: "background: #E3350D; color: white; border: 1px solid black; font-size: 5px; padding: 3px 5px; font-family: 'Press Start 2P', cursive; cursor: pointer;" do %>
                    🚩 <%= t("reviews.report") %>
                  <% end %>
                <% elsif rev.reported? %>
                  <span style="font-size: 5px; color: #E3350D;">[<%= t("reviews.reported_status") %>]</span>
                <% end %>
              </div>
            </div>

            <%# --- INFO DE LA CARTA EN LA RESEÑA --- %>
            <div style="display: flex; align-items: center; gap: 10px; background: #eee; border: 2px solid black; padding: 8px; border-radius: 5px; margin-bottom: 12px;">
              <% if rev.order_item.listing.card.image_url.present? %>
                <img src="<%= rev.order_item.listing.card.image_url %>" style="width: 30px; border: 1px solid black; border-radius: 3px;">
              <% end %>
              <div style="font-size: 7px; color: #E3350D;">
                <%= rev.order_item.listing.card.name %>
              </div>
            </div>

            <div style="font-size: 8px; line-height: 1.6; color: black; background: white; border: 2px solid #ddd; padding: 10px; border-radius: 4px; min-height: 50px; word-break: break-all;">
              "<%= rev.comment %>"
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="background: rgba(255,255,255,0.9); border: 4px solid #000; padding: 30px; text-align: center; border-radius: 10px;">
        <p style="font-size: 10px; color: #333;"><%= t("purchases.no_reviews", default: "Este entrenador aún no tiene reseñas.") %></p>
      </div>
    <% end %>
  </div>
</div>

<%# --- POP-UP DE LOGIN REQUERIDO PARA VISITANTES --- %>
<div id="login-required-popup" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.8); display: none; align-items: center; justify-content: center; z-index: 9999;">
  <div style="background: white; border: 6px solid black; padding: 40px 30px; text-align: center; max-width: 450px; font-family: 'Press Start 2P', cursive; box-shadow: 10px 10px 0px #30a7d7; position: relative;">
    
    <button onclick="document.getElementById('login-required-popup').style.display='none'" style="position: absolute; top: 10px; right: 15px; background: none; border: none; font-size: 16px; font-family: 'Press Start 2P', cursive; cursor: pointer; color: #E3350D;" class="btn-interactive">X</button>

    <h2 style="font-size: 14px; color: #30a7d7; margin-bottom: 25px; line-height: 1.4;">
      <%= t("products.notices.login_required_title", default: "¡NECESITAS UNA CUENTA!") %>
    </h2>
    
    <p style="font-size: 8px; line-height: 1.8; margin-bottom: 35px; color: #333;">
      <%= t("products.notices.login_required_body", default: "Para poder añadir productos al carro y realizar compras, debes iniciar sesión en la plataforma.") %>
    </p>
    
    <div style="display: flex; flex-direction: column; gap: 15px;">
      <%= link_to t("layout.sign_in", default: "INICIAR SESIÓN"), new_session_path, class: "btn-interactive", style: "background: #4CAF50; color: white; border: 3px solid black; padding: 15px; text-decoration: none; font-size: 9px; cursor: pointer;" %>
      <%= link_to t("layout.sign_up", default: "REGISTRARSE"), new_registration_path, class: "btn-interactive", style: "background: #FFCC00; color: black; border: 3px solid black; padding: 15px; text-decoration: none; font-size: 9px; cursor: pointer;" %>
    </div>
  </div>
</div>
