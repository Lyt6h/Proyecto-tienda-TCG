<style>
  .retro-stars {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 5px;
    position: relative; /* Ayuda a que el mensaje de error del navegador no se pierda */
  }
  
  .retro-stars input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  
  .retro-stars label {
    font-size: 24px;
    color: #ccc; 
    cursor: pointer;
    text-shadow: 2px 2px 0px #000;
    transition: color 0.1s;
  }
  
  .retro-stars label:hover,
  .retro-stars label:hover ~ label {
    color: #FFCC00 !important;
  }

  .retro-stars input[type="radio"]:checked ~ label {
    color: #FFCC00 !important;
  }
</style>

<div class="pokedex-background" style="background-color: #E3350D; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; margin: -8px;">
  
  <div style="background: white; border: 6px solid black; border-radius: 15px; padding: 40px; box-shadow: 10px 10px 0px rgba(0,0,0,0.4); max-width: 500px; width: 100%; font-family: 'Press Start 2P', cursive;">
    
    <h2 style="font-size: 14px; text-align: center; margin-bottom: 35px; color: #333;"><%= t("reviews.new_title") %></h2>
    
    <%= form_with(model: [@order_item, @review], local: true) do |f| %>
      
      <div style="margin-bottom: 25px;">
        <p style="font-size: 9px; margin-bottom: 12px; color: #333;"><%= t("reviews.item_label") %></p>
        <div class="retro-stars">
          <% (1..5).to_a.reverse.each do |i| %>
            <input type="radio" name="review[item_rating]" id="item_star_<%= i %>" value="<%= i %>" required>
            <label for="item_star_<%= i %>">★</label>
          <% end %>
        </div>
      </div>

      <div style="margin-bottom: 30px;">
        <p style="font-size: 9px; margin-bottom: 12px; color: #333;"><%= t("reviews.seller_label") %></p>
        <div class="retro-stars">
          <% (1..5).to_a.reverse.each do |i| %>
            <input type="radio" name="review[seller_rating]" id="seller_star_<%= i %>" value="<%= i %>" required>
            <label for="seller_star_<%= i %>">★</label>
          <% end %>
        </div>
      </div>

      <div style="margin-bottom: 35px;">
        <p style="font-size: 9px; margin-bottom: 12px; color: #333;"><%= t("reviews.comment_label") %></p>
        <%= f.text_area :comment, rows: 4, maxlength: 500, style:"font-family: 'Press Start 2P', cursive; font-size: 10px; padding: 15px; width: 100%; box-sizing: border-box; border: 4px solid black; background: #f8f8f8; resize: none;", required: true %>
      </div>

      <div style="display: flex; gap: 15px; justify-content: space-between;">
        <%= link_to t("reviews.cancel"), purchases_path, class: "btn-interactive", style: "flex: 1; text-align: center; background: #E3350D; color: white; border: 4px solid black; padding: 15px 10px; cursor: pointer; font-size: 9px; text-decoration: none;" %>
        
        <%= f.submit t("reviews.submit"), class: "btn-interactive", style: "flex: 1; background: #4CAF50; color: white; border: 4px solid black; padding: 15px 10px; cursor: pointer; font-family: 'Press Start 2P', cursive; font-size: 9px;" %>
      </div>

    <% end %>
  </div>
</div>